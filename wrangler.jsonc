{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compost-bank-website",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-09-08",

  // Vite builds the SPA into ./dist. Anything that is not a real file falls
  // back to index.html so react-router handles the route (replaces the
  // catch-all rewrite that vercel.json used to do).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker; page loads are served straight from
    // the edge without a Worker invocation.
    "run_worker_first": ["/api/*"]
  },

  "observability": { "enabled": true },

  // Rate limiting namespaces need no provisioning — the id is just a number
  // that scopes the counter within the account. period must be 10 or 60.
  "ratelimits": [
    {
      "name": "CONTACT_BURST",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 10 }
    },
    {
      "name": "CONTACT_SUSTAINED",
      "namespace_id": "1002",
      "simple": { "limit": 8, "period": 60 }
    }
  ]
}
